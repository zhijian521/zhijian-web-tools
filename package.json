{
  "name": "zhijian-web-tools",
  "version": "1.0.0",
  "private": true,
  "description": "知简 Web 工具集：导航、便签与资源管理，独立开发和部署。",
  "scripts": {
    "setup:home": "npm --prefix apps/home ci",
    "dev:home": "npm --prefix apps/home run dev",
    "build:home": "npm --prefix apps/home run build",
    "preview:home": "npm --prefix apps/home run preview",
    "setup:sticky-note": "npm --prefix apps/sticky-note ci",
    "dev:sticky-note": "npm --prefix apps/sticky-note run dev",
    "build:sticky-note": "npm --prefix apps/sticky-note run build",
    "preview:sticky-note": "npm --prefix apps/sticky-note run preview",
    "setup:resource-hub": "npm --prefix apps/resource-hub ci",
    "dev:resource-hub": "npm --prefix apps/resource-hub run dev -- --port 3001",
    "build:resource-hub": "npm --prefix apps/resource-hub run build",
    "preview:resource-hub": "npm --prefix apps/resource-hub run preview"
  }
}
